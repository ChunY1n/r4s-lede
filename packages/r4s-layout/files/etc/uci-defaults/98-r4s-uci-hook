#!/bin/sh
# uci 透传包装：CLI 执行 uci commit firewall 后同步 tcpcca/fullcone；
# commit network/dhcp/wizard（或全量 commit）后同步 dae-ipv6-dns（IPv6 联动）。
[ -x /sbin/uci.real ] && exit 0
[ -x /sbin/uci ] || exit 0

mv /sbin/uci /sbin/uci.real
cat > /sbin/uci <<'EOF'
#!/bin/sh
# uci 透传包装：commit 防火墙同步 tcpcca/fullcone，commit 网络/向导同步 dae-ipv6-dns
_commit=0
for _a in "$@"; do [ "$_a" = "commit" ] && _commit=1; done
_sync_fw=0
_sync_dns=0
if [ "$_commit" = "1" ]; then
	_pkg=0
	for _a in "$@"; do
		case "$_a" in
			firewall) _sync_fw=1; _pkg=1 ;;
			network|dhcp|wizard) _sync_dns=1; _pkg=1 ;;
		esac
	done
	[ "$_pkg" = "0" ] && { _sync_fw=1; _sync_dns=1; }
fi
/sbin/uci.real "$@"
_rc=$?
if [ "$_rc" = "0" ]; then
	[ "$_sync_fw" = "1" ] && /usr/bin/r4s-firewall-sync.sh >/dev/null 2>&1
	[ "$_sync_dns" = "1" ] && [ -x /usr/bin/dae-ipv6-dns.sh ] && /usr/bin/dae-ipv6-dns.sh >/dev/null 2>&1
fi
exit $_rc
EOF
chmod 755 /sbin/uci

exit 0

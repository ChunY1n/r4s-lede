#!/bin/sh /etc/rc.common

START=99

boot() {
	XBOOT=1 start
	SSID=$(uci get wireless.@wifi-iface[0].ssid 2>/dev/null)
	KEY=$(uci get wireless.@wifi-iface[0].key 2>/dev/null)
	IPADDR=$(uci get network.lan.ipaddr 2>/dev/null)
	NETMASK=$(uci get network.lan.netmask 2>/dev/null)
	fakemesh=$(uci get fakemesh.default.enabled 2>/dev/null || echo 0)

	# 清理旧固件遗留的 wizard.config（finished 标记）段，
	# 避免它被当作向导配置段处理而把 WAN 覆盖回 DHCP
	uci -q delete wizard.config
	uci commit wizard

	if [ "$(uci get wizard.default.wifi_ssid 2>/dev/null)" = "$SSID" ] && [ "$(uci get wizard.default.lan_ipaddr 2>/dev/null)" = "$IPADDR" ]; then
		:
	else
		uci set wizard.default=wizard
		[ "$fakemesh" = "1" ] || {
			uci set wizard.default.wifi_ssid="$SSID"
			uci set wizard.default.wifi_key="$KEY"
		}
		uci set wizard.default.lan_ipaddr="$IPADDR"
		uci set wizard.default.lan_netmask="$NETMASK"
		uci commit wizard
	fi
}

switch_onoff()
{
	local service=$1
	local opt=$2

	test -e /etc/init.d/$service || return 0

	if [ "$opt" = "1" ]; then
		/etc/init.d/$service enabled || {
			/etc/init.d/$service enable 2>/dev/null
			/etc/init.d/$service start &>/dev/null
		}
	else
		/etc/init.d/$service enabled && {
			/etc/init.d/$service disable 2>/dev/null
			/etc/init.d/$service stop &>/dev/null
		}
	fi
}

process_kmod_group()
{
	local opt=$1
	shift
	local mod_patterns="$*"
	local ver="$(uname -r 2>/dev/null)"
	local lib_dir="/lib/modules/$ver"
	local rom_dir="/rom/lib/modules/$ver"
	local upper_dir="/overlay/upper/lib/modules/$ver"

	[ -d "$rom_dir" ] || rom_dir="/rom/lib/modules"
	[ -d "$lib_dir" ] || lib_dir="/lib/modules"
	[ -d "$upper_dir" ] || upper_dir="/overlay/upper/lib/modules"

	for pattern in $mod_patterns; do
		if [ "$opt" = "0" ]; then
			find "$lib_dir" -name "${pattern}*" -exec rm -f {} + 2>/dev/null
		else
			if [ -d "$rom_dir" ]; then
				find "$rom_dir" -name "${pattern}*" 2>/dev/null | while read -r rom_file; do
					[ -f "$rom_file" ] || continue
					local rel_path="${rom_file#$rom_dir/}"
					local upper_file="$upper_dir/$rel_path"
					local target_file="$lib_dir/$rel_path"
					if [ -d "$upper_dir" ]; then
						rm -f "$upper_file" 2>/dev/null
					fi
					if [ ! -e "$target_file" ]; then
						local target_dir="$(dirname "$target_file")"
						mkdir -p "$target_dir"
						cp -f "$rom_file" "$target_file" 2>/dev/null
					fi
				done
			fi
		fi
	done
}

add_wizard() {
	local cfg="$1"
	# 只处理 default 向导配置段；旧固件遗留的 config（finished 标记）段必须跳过，
	# 否则它没有 wan_proto，会把 network.wan 覆盖回 DHCP
	[ "$cfg" = "default" ] || return 0
	local opt
	config_get opt "$cfg" ipv6 '0'
	switch_onoff odhcpd $opt
	if [ "$opt" = "1" ]; then
		# 开启 IPv6：恢复 RA/DHCPv6、LAN 前缀分配、wan6
		uci -q get dhcp.lan.interface >/dev/null && {
			uci set dhcp.lan.ra='server'
			uci set dhcp.lan.dhcpv6='server'
			uci set dhcp.lan.ra_slaac='1'
			uci -q delete dhcp.lan.ndp
			uci -q delete dhcp.lan.ra_flags
			uci -q add_list dhcp.lan.ra_flags='managed-config'
			uci -q add_list dhcp.lan.ra_flags='other-config'
		}
		uci -q delete network.lan.delegate
		uci -q delete network.lan.ip6class
		uci -q get network.lan.ip6assign >/dev/null || uci set network.lan.ip6assign='60'
		uci -q delete network.lan6
		uci -q set network.wan.ipv6='auto'
		uci -q delete network.wan6.auto
		uci -q set dhcp.@dnsmasq[0].filter_aaaa='0'
		# 重新开启内核 IPv6 栈
		rm -f /etc/sysctl.d/90-r4s-ipv6-off.conf
		sysctl -w net.ipv6.conf.all.disable_ipv6=0 net.ipv6.conf.default.disable_ipv6=0 >/dev/null 2>&1
		# 恢复 xwan 健康检查中的 IPv6 地址
		if [ -f /etc/config/xwan ]; then
			local _xt _has=0
			for _xt in $(uci -q get wizard.default.xwan_track_ip6 2>/dev/null); do
				uci -q del_list xwan.@xwan[0].track_ip="$_xt"
				uci -q add_list xwan.@xwan[0].track_ip="$_xt"
				_has=1
			done
			[ "$_has" = "0" ] && {
				uci -q add_list xwan.@xwan[0].track_ip='2402:4e00::'
				uci -q add_list xwan.@xwan[0].track_ip='2400:3200::1'
			}
			uci -q delete wizard.default.xwan_track_ip6
			uci commit wizard
			uci commit xwan
		fi
	else
		# 关闭 IPv6（冗余兜底）：停 odhcpd、dnsmasq RA/DHCPv6、LAN 前缀分配、wan6，
		# 并清理 relay/NAT6/静态 v6 等历史配置，确保任何场景下都关得干净
		uci -q get dhcp.lan.interface >/dev/null && {
			uci set dhcp.lan.ra='disabled'
			uci set dhcp.lan.dhcpv6='disabled'
			uci -q delete dhcp.lan.ndp
			uci -q delete dhcp.lan.ra_slaac
			uci -q delete dhcp.lan.ra_flags
		}
		uci -q delete network.lan.delegate
		uci -q delete network.lan.ip6class
		uci -q delete network.lan.ip6assign
		uci -q delete network.lan.ip6addr
		uci -q delete network.lan6
		uci -q set network.wan.ipv6='0'
		uci -q get network.wan6 >/dev/null && uci set network.wan6.auto='0'
		uci -q delete network.wan6.ip6addr
		# 冗余清理：odhcpd 中继（relay）残留
		uci -q delete dhcp.wan.master
		uci -q delete dhcp.wan.ra
		uci -q delete dhcp.wan.dhcpv6
		uci -q delete dhcp.wan.ndp
		uci -q delete dhcp.wan6.master
		uci -q delete dhcp.wan6.ra
		uci -q delete dhcp.wan6.dhcpv6
		uci -q delete dhcp.wan6.ndp
		# 冗余清理：IPv6 NAT（nat6 include）
		if [ "$(uci -q get firewall.nat6.reload)" = "1" ]; then
			uci -q delete network.wan6.sourcefilter
			uci -q delete firewall.@zone[1].masq6
			uci -q delete firewall.nat6
			uci commit firewall
			if [ "x$XBOOT" != "x1" ]; then
				/etc/init.d/firewall reload >/dev/null 2>&1
			fi
		fi
		# 同步关闭 mwan3 的 IPv6 追踪，避免无 IPv6 时追踪器空转刷日志
		if [ -f /etc/config/mwan3 ]; then
			local _mi _mt
			for _mi in $(uci show mwan3 2>/dev/null | sed -n "s/^mwan3\.\([^.]*\)=interface$/\1/p"); do
				uci -q set mwan3.$_mi.family='ipv4'
				for _mt in $(uci -q get mwan3.$_mi.track_ip 2>/dev/null); do
					case "$_mt" in
						*:*) uci -q del_list mwan3.$_mi.track_ip="$_mt" ;;
					esac
				done
			done
			uci commit mwan3
			/etc/init.d/mwan3 restart >/dev/null 2>&1
		fi
		# 彻底关闭内核 IPv6 栈，dae 不再解析/尝试 IPv6 节点
		cat > /etc/sysctl.d/90-r4s-ipv6-off.conf <<'EOF'
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
EOF
		sysctl -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1
		# 同步移除 xwan 健康检查中的 IPv6 地址（IPv6 关闭时）
		if [ -f /etc/config/xwan ]; then
			local _xt
			uci -q delete wizard.default.xwan_track_ip6
			for _xt in $(uci -q get xwan.@xwan[0].track_ip 2>/dev/null); do
				case "$_xt" in
					*:*) uci -q add_list wizard.default.xwan_track_ip6="$_xt" ;;
				esac
			done
			for _xt in $(uci -q get wizard.default.xwan_track_ip6 2>/dev/null); do
				uci -q del_list xwan.@xwan[0].track_ip="$_xt"
			done
			uci commit wizard
			uci commit xwan
		fi
		uci -q set dhcp.@dnsmasq[0].filter_aaaa='1'
	fi
	uci commit dhcp
	uci commit network
	# dnsmasq 需要重启才会重新生成配置文件，否则 RA/DHCPv6 开关不生效
	if [ "x$XBOOT" != "x1" ]; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi

	if [ "x$XBOOT" != "x1" ]; then
		local wan_proto wan_ipaddr wan_netmask wan_gateway wan_dns wan_pppoe_user wan_pppoe_pass
		local wifi_ssid wifi_key
		local lan_ipaddr lan_netmask
		local device ifname
		local saved_wan_opts _k _v _pair

		config_get wan_proto "$cfg" wan_proto dhcp

		device=$(uci get network.wan.device 2>/dev/null)
		ifname=$(uci get network.wan.ifname 2>/dev/null)
		# 保存向导不管理的其他 wan 选项（如 xwan/mwan3 的 norelease/multipath），
		# 避免重建 wan 段时把它们弄丢
		saved_wan_opts=""
		for _k in $(uci show network.wan 2>/dev/null | sed -n "s/^network\.wan\.\([^=]*\)=.*/\1/p"); do
			case "$_k" in
				device|ifname|proto|metric|username|password|keepalive|mtu|ipv6|peerdns|dns|force_link|ipaddr|netmask|gateway) ;;
				*) _v=$(uci -q get network.wan.$_k); saved_wan_opts="$saved_wan_opts $_k=$_v" ;;
			esac
		done
		case "${wan_proto}" in
			dhcp)
				uci delete network.wan
				uci set network.wan=interface
				test -n "$device" && uci set network.wan.device="$device"
				test -n "$ifname" && uci set network.wan.ifname="$ifname"
				uci set network.wan.proto='dhcp'
				uci set network.wan.metric='40'

				config_get wan_dns "$cfg" wan_dns
				test -n "${wan_dns}" && {
					uci set network.wan.peerdns='0'
					uci set network.wan.dns="${wan_dns}"
				}
			;;
			static)
				config_get wan_ipaddr "$cfg" wan_ipaddr
				config_get wan_netmask "$cfg" wan_netmask
				config_get wan_gateway "$cfg" wan_gateway
				test -n "${wan_ipaddr}" && test -n "${wan_netmask}" && {
					uci delete network.wan
					uci set network.wan=interface
					uci set network.wan.proto='static'
					uci set network.wan.force_link='0'
					test -n "$device" && uci set network.wan.device="$device"
					test -n "$ifname" && uci set network.wan.ifname="$ifname"
					uci set network.wan.metric='40'
					uci set network.wan.ipaddr="${wan_ipaddr}"
					uci set network.wan.netmask="${wan_netmask}"
					uci set network.wan.gateway="${wan_gateway}"

					config_get wan_dns "$cfg" wan_dns
					test -n "${wan_dns}" && {
						uci set network.wan.peerdns='0'
						uci set network.wan.dns="${wan_dns}"
					}
				}
			;;
			pppoe)
				config_get wan_pppoe_user "$cfg" wan_pppoe_user
				config_get wan_pppoe_pass "$cfg" wan_pppoe_pass
				uci delete network.wan
				uci set network.wan=interface
				uci set network.wan.proto='pppoe'
				test -n "$device" && uci set network.wan.device="$device"
				test -n "$ifname" && uci set network.wan.ifname="$ifname"
			uci set network.wan.metric='40'
			uci set network.wan.username="${wan_pppoe_user}"
			uci set network.wan.password="${wan_pppoe_pass}"
			uci set network.wan.keepalive='5 5'
			uci set network.wan.mtu='1492'
			if [ "$opt" = "1" ]; then
				uci set network.wan.ipv6='auto'
			else
				uci set network.wan.ipv6='0'
			fi

			config_get wan_dns "$cfg" wan_dns
				test -n "${wan_dns}" && {
					uci set network.wan.peerdns='0'
					uci set network.wan.dns="${wan_dns}"
				}
			;;
		esac

		for _pair in $saved_wan_opts; do
			_k="${_pair%%=*}"
			_v="${_pair#*=}"
			uci set network.wan.$_k="$_v"
		done

		config_get lan_ipaddr "$cfg" lan_ipaddr
		config_get lan_netmask "$cfg" lan_netmask
		test -n "${lan_ipaddr}" && test -n "${lan_netmask}" && {
			uci set network.lan.ipaddr="${lan_ipaddr}"
			uci set network.lan.netmask="${lan_netmask}"
		}

		fakemesh=$(uci get fakemesh.default.enabled 2>/dev/null || echo 0)
		if ! [ "$fakemesh" = "1" ]; then

		config_get wifi_ssid "$cfg" wifi_ssid
		config_get wifi_key "$cfg" wifi_key

		test -n "${wifi_ssid}" && test -n "${wifi_key}" && {
			for idx in `seq 0 64`; do
				uci get wireless.@wifi-iface[$idx] 2>/dev/null || break
				[ "$(uci get wireless.@wifi-iface[$idx].mode 2>/dev/null)" = "ap" ] && {
					subfix="$(uci get wireless.@wifi-iface[$idx].subfix 2>/dev/null)"
					uci set wireless.@wifi-iface[$idx].ssid="${wifi_ssid}${subfix}"
					uci set wireless.@wifi-iface[$idx].key="${wifi_key}"
					uci set wireless.@wifi-iface[$idx].encryption='psk2'
				}
				device=$(uci get wireless.@wifi-iface[$idx].device)
				[ "$(uci get wireless.${device}.band)" = "2g" ] || [ "$(uci get wireless.${device}.band)" = "5g" ] || {
					uci set wireless.@wifi-iface[$idx].ocv='0'
					uci set wireless.@wifi-iface[$idx].ssid="${wifi_ssid}_6G"
					uci set wireless.@wifi-iface[$idx].key="${wifi_key}"
					uci set wireless.@wifi-iface[$idx].encryption='sae'
					uci delete wireless.@wifi-iface[$idx].ft_psk_generate_local
					uci set wireless.${device}.country='DE'
					uci set wireless.${device}.channel='21'
					uci set wireless.${device}.band='6g'
				}
			done
		}

		fi

		uci commit network
		uci commit wireless
		(sleep 15
		 /etc/init.d/network reload
		 /etc/init.d/dnsmasq reload)&
	fi

	config_get opt "$cfg" kmod_wireguard '1'
	process_kmod_group $opt wireguard.ko

	config_get opt "$cfg" kmod_openvpn_tun '1'
	process_kmod_group $opt tun.ko

	config_get opt "$cfg" kmod_alg '1'
	process_kmod_group $opt nf_nat_sip.ko nf_conntrack_sip.ko nf_nat_h323.ko nf_conntrack_h323.ko nf_nat_pptp.ko nf_conntrack_pptp.ko nf_nat_ftp.ko nf_conntrack_ftp.ko nf_nat_amanda.ko nf_conntrack_amanda.ko nf_nat_irc.ko nf_conntrack_irc.ko nf_nat_tftp.ko nf_conntrack_tftp.ko nf_nat_snmp_basic.ko nf_conntrack_snmp.ko

	config_get opt "$cfg" kmod_crypto '1'
	process_kmod_group $opt cryptodev.ko algif_hash.ko algif_skcipher.ko algif_aead.ko algif_rng.ko crypto_user.ko

	config_get opt "$cfg" kmod_usb '1'
	process_kmod_group $opt usbcore.ko usb-common.ko usb-storage.ko usbnet.ko usbserial.ko
}

start() {
	config_load wizard
	config_foreach add_wizard wizard
}

restart() {
	XRELOAD=1 start
}
